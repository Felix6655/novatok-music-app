# NovaTok Music Environment Variables
# Copy this file to .env.local and fill in your values

# MongoDB Connection (for local development)
MONGO_URL=mongodb://localhost:27017
DB_NAME=novatok_music

# ===========================================
# CANONICAL SITE URL (Required for SEO)
# ===========================================
# Used for: sitemap, robots.txt, OG tags, canonical URLs, JSON-LD
# Falls back to window.location.origin on client if not set
# Example: https://novatok.music or https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# ===========================================
# Supabase Configuration (optional)
# ===========================================
# Enables cloud sync, uploads, and user accounts
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (for server-side operations)
# Only needed for admin operations
SUPABASE_SERVICE_ROLE_KEY=

# ===========================================
# Feature Flags
# ===========================================
# Set to 'true' to require Supabase (disables guest mode)
NEXT_PUBLIC_REQUIRE_SUPABASE=false

# CORS Origins (comma separated)
CORS_ORIGINS=*
