# NovaTok Music Environment Variables
# Copy this file to .env.local and fill in your values

# MongoDB Connection (for local development)
MONGO_URL=mongodb://localhost:27017
DB_NAME=novatok_music

# ===========================================
# CANONICAL SITE URL (Required for SEO)
# ===========================================
# Used for: sitemap, robots.txt, OG tags, canonical URLs
# Example: https://novatok.music or https://your-domain.com
# ⚠️ Set NEXT_PUBLIC_SITE_URL in Vercel for production.
NEXT_PUBLIC_SITE_URL=

# ===========================================
# Supabase Configuration (REQUIRED for production)
# ===========================================
# Get these from your Supabase project settings > API
# Without these, the app runs in Guest Mode (demo only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (for server-side admin operations)
# Only needed for server-side operations
SUPABASE_SERVICE_ROLE_KEY=

# ===========================================
# Feature Flags
# ===========================================
# Set to 'true' to require Supabase (disables guest mode)
NEXT_PUBLIC_REQUIRE_SUPABASE=false

# CORS Origins (comma separated)
CORS_ORIGINS=*

# ===========================================
# Marketing Automation (Optional)
# ===========================================
# n8n webhook URL - triggered on every track upload
# Get this from your n8n workflow webhook trigger node
# See MARKETING_AUTOMATION.md for setup instructions
N8N_WEBHOOK_URL=

# ===========================================
# Production Setup Checklist
# ===========================================
# 1. Create Supabase project at https://supabase.com
# 2. Run migrations:
#    - supabase/migrations/001_music.sql
#    - supabase/migrations/002_production_upgrade.sql
# 3. Create storage buckets:
#    - music-audio (public read, auth write)
#    - music-covers (public read, auth write)
# 4. Enable Google OAuth in Supabase Auth settings (optional)
# 5. Set environment variables above
# 6. Deploy!
